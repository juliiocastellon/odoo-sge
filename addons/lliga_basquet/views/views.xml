<odoo>
    <!-- ===== EQUIP ===== -->
    <record id="basquet_equip_list" model="ir.ui.view">
        <field name="name">basquet.equip.list</field>
        <field name="model">basquet.equip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ciutat"/>
                <field name="estadi_id"/>
            </list>
        </field>
    </record>

    <record id="basquet_equip_form" model="ir.ui.view">
        <field name="name">basquet.equip.form</field>
        <field name="model">basquet.equip</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ciutat"/>
                        <field name="estadi_id"/>
                    </group>
                    <notebook>
                        <page string="Jugadors">
                            <field name="jugador_ids"/>
                        </page>
                        <page string="Agermanats">
                            <field name="equips_agermanats_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Rivals">
                            <field name="equips_rivals_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== JUGADOR ===== -->
    <record id="basquet_jugador_list" model="ir.ui.view">
        <field name="name">basquet.jugador.list</field>
        <field name="model">basquet.jugador</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="equip_id"/>
                <field name="estadi_nom"/>
                <field name="es_capita"/>
            </list>
        </field>
    </record>

    <!-- ===== ACCIONS ===== -->
    <record id="action_basquet_equip" model="ir.actions.act_window">
        <field name="name">Equips</field>
        <field name="res_model">basquet.equip</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_basquet_jugador" model="ir.actions.act_window">
        <field name="name">Jugadors</field>
        <field name="res_model">basquet.jugador</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_basquet_pavello" model="ir.actions.act_window">
        <field name="name">Pavellons</field>
        <field name="res_model">basquet.pavello</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== MENÚS ===== -->
    <menuitem id="menu_basquet_root" name="Lliga de Bàsquet"/>
    <menuitem id="menu_basquet_equip" name="Equips"
              parent="menu_basquet_root" action="action_basquet_equip"/>
    <menuitem id="menu_basquet_jugador" name="Jugadors"
              parent="menu_basquet_root" action="action_basquet_jugador"/>
    <menuitem id="menu_basquet_pavello" name="Pavellons"
              parent="menu_basquet_root" action="action_basquet_pavello"/>
</odoo>
